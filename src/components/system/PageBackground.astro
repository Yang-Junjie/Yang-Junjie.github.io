---
import { resolveAsset } from "@utils/asset-utils";
import { url } from "@utils/url-utils";
import { siteConfig } from "@/config";

const background = siteConfig.background;
// Short-circuit before asset resolution: omitted/disabled/empty means no image,
// feature DOM, styles or client runtime in either source or npm package mode.
const source = background?.enable ? background.src?.trim() : "";
const src = source ? url(await resolveAsset(source)) : "";
---

{src && (
	<>
		<div id="page-background" aria-hidden="true">
			<img
				src={src}
				alt=""
				decoding="async"
				style={{ objectPosition: background?.position || "center" }}
			/>
		</div>
		{/* Inline and conditional so disabled backgrounds contribute no CSS. */}
		<style is:inline data-page-background>
			#page-background {
				position: fixed;
				inset: 0;
				width: 100vw;
				height: 100vh;
				z-index: -20;
				pointer-events: none;
			}
			#page-background img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			@media print {
				#page-background { display: none; }
			}
		</style>
	</>
)}
